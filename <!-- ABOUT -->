  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;700&family=Manrope:wght@400;600;700&display=swap" rel="stylesheet">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>

  <style>
    :root{
      --bg: #ECECEC;
      --paper: rgba(247,247,247,.6);
      --ink: #2A2A2A;
      --accent: #6B6B6B;
      --shadow: 0 18px 48px rgba(0,0,0,.10);
      --gold: #C89B3C;
    }

    *{margin:0;padding:0;box-sizing:border-box}
    html{scroll-behavior:smooth;scroll-padding-top:80px;}
    body{font-family:"Manrope",system-ui,sans-serif;background:var(--bg);color:var(--ink);}

    /* fundo fixo */
    .bg-fixed{
      position:fixed;
      inset:0;
      background:url("hero-principal.jpg") center 30% / cover no-repeat;
      filter:grayscale(100%);
      opacity:1;
      z-index:-2;
    }
    .bg-overlay{
      position:fixed;
      inset:0;
      background:rgba(236,236,236,.03);
      z-index:-1;
    }

    /* topo */
    nav{
      position:fixed;top:0;left:0;right:0;
      background:rgba(247,247,247,.88);
      backdrop-filter:blur(10px);
      border-bottom:1px solid rgba(0,0,0,.03);
      z-index:999;
    }
    .nav-inner{
      max-width:1180px;
      margin:auto;
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:.75rem 1.1rem;
    }
    .brand-block{
      display:flex;
      flex-direction:column;
      align-items:center;       /* centraliza nome e subtítulo */
      text-align:center;
    }
    .brand{
      font-family:"Cinzel",serif;
      letter-spacing:.14em;
      text-transform:uppercase;
      font-size:1.5rem;
      font-weight:500;
      color:var(--gold);
      text-decoration:none;
      cursor:pointer;
    }
    .brand-sub{
      font-family:"Cinzel",serif;
      font-size:.58rem;
      letter-spacing:.28em;
      text-transform:uppercase;
      color:rgba(0,0,0,.55);
      margin-top:.15rem;
      white-space:nowrap;
    }
    .burger{
      background:none;border:0;
      font-size:1.4rem;
      cursor:pointer;
      color:var(--ink);
    }

    /* menu lateral */
    .sheet{
      position:fixed;top:0;right:0;bottom:0;
      width:280px;max-width:100%;
      background:rgba(247,247,247,.96);
      backdrop-filter:blur(12px);
      transform:translateX(110%);
      transition:.3s ease;
      z-index:1000;
      padding:1.2rem .5rem 1.3rem;
      display:flex;flex-direction:column;align-items:center;gap:.4rem;
    }
    .sheet.open{ transform:translateX(0); }
    .sheet .close{
      background:none;border:0;
      align-self:flex-end;
      font-size:1.3rem;
      cursor:pointer;
      color:var(--ink);
      margin-bottom:.6rem;
    }
    .sheet a{
      width:100%;
      text-align:center;
      padding:.55rem .5rem;
      border-radius:8px;
      text-decoration:none;
      color:var(--ink);
      font-family:"Cinzel",serif;
      font-weight:400;
      letter-spacing:.04em;
      font-size:.9rem;
    }
    .sheet a:hover{ background:rgba(200,155,60,.18); }

    .lang-switch{ margin-top:auto; display:flex; gap:.35rem; }
    .pill{
      border:0;
      background:rgba(42,42,42,.08);
      border-radius:999px;
      padding:.35rem .85rem;
      font-weight:700;
      cursor:pointer;
    }
    .pill.active{ background:var(--gold); color:#fff; }

    /* estrutura geral */
    main{ margin-top:80px; }
    section{
      max-width:1180px;
      margin:0 auto 3rem;
      padding:0 1.1rem;
    }

    /* mais espaço pra foto */
    .hero-gap{
      height:75vh;
      min-height:520px;
    }

    /* títulos */
    .section-title{
      font-family:"Cinzel",serif;
      font-size:1.5rem;         /* mesmo ar do nome */
      letter-spacing:.04em;
      margin-bottom:1.3rem;
      text-transform:lowercase;
      font-weight:400;
    }

    /* about */
    .about{
      display:grid;
      grid-template-columns:1.2fr .8fr;
      gap:2rem;
      padding:2.4rem;
      margin-top:-100px;
      background:var(--paper);
      border-radius:26px;
      box-shadow:var(--shadow);
      backdrop-filter:blur(4px);
    }
    .about p{ margin-bottom:1rem; line-height:1.7; }
    .about-img{
      border-radius:20px;
      overflow:hidden;
      box-shadow:0 18px 44px rgba(0,0,0,.14);
    }
    .about-img img{ width:100%; height:100%; object-fit:cover; }

    /* offerings */
    .offerings{
      margin-top:2rem;
      padding:2.2rem;
      border-radius:26px;
      background:var(--paper);
      box-shadow:var(--shadow);
      display:grid;
      grid-template-columns:1.05fr .85fr;
      gap:2rem;
      align-items:center;
      backdrop-filter:blur(4px);
    }
    .offerings p{ margin-bottom:1rem; }
    .offerings-img{
      border-radius:20px;
      overflow:hidden;
      box-shadow:0 18px 44px rgba(0,0,0,.14);
    }
    .offerings-img img{ width:100%; height:100%; object-fit:cover; display:block; }

    /* journey */
    .journey{
      background:var(--paper);
      border-radius:26px;
      box-shadow:var(--shadow);
      padding:2.2rem;
      backdrop-filter:blur(3px);
    }
    .journey p{ line-height:1.7; }

    /* links */
    .benefits-wrap{
      background:var(--paper);
      border-radius:26px;
      box-shadow:var(--shadow);
      padding:2.2rem;
      backdrop-filter:blur(3px);
    }
    .benefit-cards{ display:flex; gap:1rem; }
    .benefit-card{
      background:rgba(255,255,255,.9);
      border-radius:18px;
      padding:.6rem .9rem 1rem;
      width:31%;
      text-align:center;
      box-shadow:0 10px 30px rgba(0,0,0,.07);
    }
    .benefit-card a{
      display:block;
      font-weight:700;
      color:var(--ink);
      text-decoration:none;
      margin-bottom:.65rem;
      font-family:"Manrope",sans-serif;
    }
    .benefit-card img{
      width:100%;
      border-radius:12px;
      aspect-ratio:4/3;
      object-fit:cover;
    }

    /* comments slider */
    .comments-panel{
      background:var(--paper);
      border-radius:26px;
      box-shadow:var(--shadow);
      padding:2.1rem 2.1rem 2.6rem;
      backdrop-filter:blur(4px);
      position:relative;
      overflow:hidden;
    }
    .comments-track{
      display:flex;
      transition:transform .35s ease;
    }
    .comment-card{
      min-width:100%;
      background:rgba(255,255,255,.75);
      border-radius:18px;
      padding:1.6rem 1.5rem 1.2rem;
      line-height:1.6;
    }
    .comment-author{
      margin-top:1rem;
      font-weight:700;
      font-family:"Cinzel",serif;
    }
    .comment-nav{
      position:absolute;
      top:50%;
      transform:translateY(-50%);
      width:36px;height:36px;
      border-radius:999px;
      border:none;
      background:rgba(0,0,0,.25);
      color:#fff;
      cursor:pointer;
      display:flex;align-items:center;justify-content:center;
    }
    .comment-prev{ left:1.2rem; }
    .comment-next{ right:1.2rem; }

    /* form abaixo dos comentários */
    .feedback-form{
      background:var(--paper);
      border-radius:26px;
      box-shadow:var(--shadow);
      padding:2rem;
      backdrop-filter:blur(4px);
    }
    .feedback-form label{ display:block; margin-bottom:.35rem; font-weight:600; }
    .feedback-form input,
    .feedback-form textarea{
      width:100%;
      border:1px solid rgba(0,0,0,.08);
      border-radius:999px;
      padding:.6rem .9rem;
      font-family:inherit;
      margin-bottom:1rem;
    }
    .feedback-form textarea{
      border-radius:16px;
      min-height:130px;
      resize:vertical;
    }
    .feedback-form button{
      border:0;
      background:var(--gold);
      color:#fff;
      padding:.6rem 1.2rem;
      border-radius:999px;
      cursor:pointer;
      font-weight:600;
    }

    /* contact */
    #contact .panel{
      background:var(--paper);
      border-radius:26px;
      box-shadow:var(--shadow);
      padding:2.1rem;
      backdrop-filter:blur(4px);
    }

    footer{
      background:linear-gradient(180deg,#2C2C2C 0%,#1D1D1D 100%);
      color:#fff;
      text-align:center;
      padding:2.4rem 1rem 2.8rem;
      margin-top:3rem;
    }
    footer .icons{ display:flex; justify-content:center; gap:1rem; margin-top:.9rem; }
    footer a{ color:#fff; }

    /* responsivo */
    @media(max-width:960px){
      .about{ grid-template-columns:1fr; margin-top:-50px; }
      .offerings{ grid-template-columns:1fr; }
      .benefit-cards{ flex-wrap:wrap; }
      .benefit-card{ width:31%; min-width:150px; }
      .nav-inner{gap:1rem;}
    }
    @media(max-width:720px){
      .about,.offerings,.journey,.benefits-wrap,.comments-panel,.feedback-form{ padding:1.6rem 1.2rem 1.8rem; }
      .benefit-card{ width:100%; }
      .sheet{ width:100%; }
      .comment-prev{ left:.4rem; }
      .comment-next{ right:.4rem; }
      .hero-gap{height:68vh;}
    }
