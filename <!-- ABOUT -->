<script>
  // abre/fecha menu
  const sheet = document.getElementById('sheet');
  document.getElementById('openSheet').addEventListener('click', () => {
    sheet.classList.add('open');
    sheet.setAttribute('aria-hidden','false');
  });
  document.getElementById('closeSheet').addEventListener('click', closeSheet);
  function closeSheet(){
    sheet.classList.remove('open');
    sheet.setAttribute('aria-hidden','true');
  }

  // carrossel de comentários
  const track = document.getElementById('commentsTrack');
  const cards = track.children;
  const total = cards.length;
  let index = 0;
  function updateComments(){
    track.style.transform = `translateX(-${index * 100}%)`;
  }
  document.getElementById('nextComment').onclick = () => {
    index = (index + 1) % total;
    updateComments();
  };
  document.getElementById('prevComment').onclick = () => {
    index = (index - 1 + total) % total;
    updateComments();
  };
</script>
